[Unit]
Description=Birthday Counter Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/birthday-counter-bot
ExecStart=/opt/birthday-counter-bot/venv/bin/python /opt/birthday-counter-bot/main.py
Restart=always
RestartSec=5
EnvironmentFile=/opt/birthday-counter-bot/.env

[Install]
WantedBy=multi-user.target
